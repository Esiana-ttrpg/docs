{
  "version": "0.2",
  "language": "en,en-GB",
  "dictionaryDefinitions": [
    {
      "name": "project-terms",
      "path": "./dictionaries/project-terms.txt",
      "addWords": true
    },
    {
      "name": "ttrpg-terms",
      "path": "./dictionaries/ttrpg-terms.txt",
      "addWords": true
    },
    {
      "name": "technical-terms",
      "path": "./dictionaries/technical-terms.txt",
