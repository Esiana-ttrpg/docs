---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = Astro.locals.starlightRoute;
const requestedMode = Astro.url.searchParams.get('nav');
const apiRoute = new RegExp(`^${base}/(?:api|architecture)(?:/|$)`).test(Astro.url.pathname);
const mode = requestedMode === 'api' || apiRoute ? 'api' : 'docs';
const prefix = mode === 'api' ? 'API · ' : 'Docs · ';

route.sidebar = route.sidebar
  .filter((entry) => entry.type === 'group' && entry.label.startsWith(prefix))
  .map((entry) => ({ ...entry, label: entry.label.slice(prefix.length) }));
---

<nav class="mode-switch" aria-label="Documentation mode">
  <a href={`${base}/`} aria-current={mode === 'docs' ? 'page' : undefined}>Docs</a>
  <a href={`${base}/api/`} aria-current={mode === 'api' ? 'page' : undefined}>API</a>
</nav>

<DefaultSidebar />

<style>
  .mode-switch { display: grid; grid-template-columns: 1fr 1fr; gap: .2rem; margin: 0 .5rem 1rem; padding: .2rem; border: 1px solid var(--sl-color-hairline); border-radius: .5rem; background: var(--sl-color-bg-nav); }
  .mode-switch a { border-radius: .32rem; padding: .38rem .55rem; color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); font-weight: 600; text-align: center; text-decoration: none; }
  .mode-switch a:hover, .mode-switch a:focus-visible { color: var(--sl-color-white); }
  .mode-switch a[aria-current='page'] { background: var(--sl-color-text-accent); color: var(--sl-color-text-invert); }
</style>
