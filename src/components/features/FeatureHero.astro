---
import FeatureImage from './FeatureImage.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section aria-label="Multiple worlds and campaigns" class="worlds">
  <FeatureImage id="global-home" priority />
  <div class="intro">
    <h2>Multiple Worlds &amp; Campaigns</h2>
    <div>
      <p>Move between worlds and campaigns without leaving their histories behind. Start something new, gather your people, and give each story a home of its own.</p>
      <a href={`${base}/features/campaign-hub/`}>Explore worlds and campaigns ↗</a>
    </div>
  </div>
  <details>
    <summary>See campaign creation and another view of home</summary>
    <div class="supporting"><FeatureImage id="create-campaign" compact /><FeatureImage id="global-home-alternate" compact /></div>
  </details>
</section>
<style>
  .worlds { padding-bottom: 3rem; }
  .intro { display: grid; gap: 1.5rem; margin-block: 2.5rem; }
  h2 { margin: 0; color: var(--sl-color-white); font-size: clamp(1.75rem, 4vw, 2.75rem); letter-spacing: -.03em; line-height: 1.15; }
  p { margin: 0 0 1rem; font-size: var(--sl-text-lg); line-height: 1.7; }
  a { color: var(--sl-color-text-accent); }
  details { margin-top: 2rem; }
  summary { cursor: pointer; padding: .75rem 0; font-size: var(--sl-text-sm); }
  .supporting { display: grid; gap: 1.5rem; margin-top: 1rem; }
  @media (min-width: 45rem) { .intro { grid-template-columns: 1fr 1.25fr; gap: 3rem; } .supporting { grid-template-columns: 1fr 1fr; } }
</style>
