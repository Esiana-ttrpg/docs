---
import FeatureImage from './FeatureImage.astro';
import FeatureStatus from './FeatureStatus.astro';
interface Props { title: string; description: string; image: string; documentationUrl: string; documentationLabel: string; maturity?: string }
const { title, description, image, documentationUrl, documentationLabel, maturity } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<article>
  <FeatureImage id={image} compact />
  <h3>{title} <FeatureStatus maturity={maturity} /></h3>
  <p>{description}</p>
  <a class="guide" href={`${base}/${documentationUrl}`}>{documentationLabel} <span aria-hidden="true">↗</span></a>
</article>
<style>
  article { min-width: 0; }
  h3 { margin: 1.25rem 0 .65rem; font-size: var(--sl-text-xl); line-height: 1.3; color: var(--sl-color-white); }
  p { margin: 0 0 1rem; font-size: var(--sl-text-base); line-height: 1.7; }
  .guide { color: var(--sl-color-text-accent); text-underline-offset: .25em; }
</style>
