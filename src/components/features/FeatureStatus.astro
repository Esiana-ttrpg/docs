---
interface Props { maturity?: string }
const { maturity } = Astro.props;
---
{maturity === 'beta' && <span class="status">Beta</span>}
<style>
  .status { display: inline-block; padding: .15em .65em; border: 1px solid var(--sl-color-gray-4); border-radius: 999px; color: var(--sl-color-gray-2); font-size: var(--sl-text-xs); font-weight: 500; vertical-align: middle; }
</style>
