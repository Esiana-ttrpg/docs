---
import type { Feature } from '../../data/feature-showcase';
import FeatureGallery from './FeatureGallery.astro';
import FeatureCard from './FeatureCard.astro';
import FeatureStatus from './FeatureStatus.astro';
interface Props { feature: Feature }
const { feature } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section id={feature.id} aria-labelledby={`${feature.id}-title`} class:list={[feature.emphasis, feature.layout]}>
  <header>
    <p class="eyebrow">{feature.category}</p>
    <h2 id={`${feature.id}-title`}>{feature.title}</h2>
    <p class="description">{feature.description}</p>
    {!feature.companions && <div class="documentation-links">
      <a href={`${base}/${feature.documentationUrl}`}>{feature.documentationLabel} <span aria-hidden="true">↗</span></a>
      {feature.secondaryDocumentation && <a href={`${base}/${feature.secondaryDocumentation.url}`}>{feature.secondaryDocumentation.label} <span aria-hidden="true">→</span></a>}
    </div>}
  </header>
  {feature.companions ? <div class="cards" style={`--columns: ${feature.companions.length}`}>
    {feature.companions.map((card) => <FeatureCard {...card} />)}
  </div> : <FeatureGallery images={feature.images} layout={feature.layout} />}
  {feature.callout && <aside class="capability-callout" aria-labelledby={`${feature.id}-callout-title`}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <rect x="9" y="2" width="6" height="12" rx="3" />
      <path d="M5 10a7 7 0 0 0 14 0M12 17v5M8 22h8" />
    </svg>
    <div>
      <h3 id={`${feature.id}-callout-title`}>{feature.callout.title} <FeatureStatus maturity={feature.callout.maturity} /></h3>
      <p>{feature.callout.description}</p>
      <a href={`${base}/${feature.callout.documentationUrl}`}>{feature.callout.documentationLabel} <span aria-hidden="true">↗</span></a>
    </div>
  </aside>}
  {feature.invitation && <p class="invitation">{feature.invitation.text} <a href={feature.invitation.url}>{feature.invitation.label}</a>.</p>}
</section>
<style>
  section { padding-block: clamp(3rem, 7vw, 6rem); border-top: 1px solid var(--sl-color-hairline); scroll-margin-top: 7rem; }
  header { max-width: 47rem; margin-bottom: 2.25rem; }
  .eyebrow { margin: 0 0 1rem; font-size: var(--sl-text-sm); font-weight: 600; color: var(--sl-color-text-accent); letter-spacing: .08em; text-transform: uppercase; }
  h2 { margin: 0; color: var(--sl-color-white); font-size: clamp(1.85rem, 4vw, 3.15rem); line-height: 1.12; letter-spacing: -.035em; text-wrap: balance; }
  .description { margin: 1.25rem 0; font-size: var(--sl-text-lg); line-height: 1.7; text-wrap: pretty; }
  .documentation-links { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; }
  .documentation-links a { color: var(--sl-color-text-accent); text-underline-offset: .25em; }
  .cards { display: grid; gap: 2.5rem 1.5rem; }
  .capability-callout { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; max-width: 47rem; margin-top: 2rem; padding: 1.5rem 0 0; border-top: 1px solid var(--sl-color-hairline); color: var(--sl-color-text); }
  .capability-callout > svg { margin-top: .15rem; color: var(--sl-color-text-accent); }
  .capability-callout h3 { margin: 0 0 .6rem; color: var(--sl-color-white); font-size: var(--sl-text-lg); line-height: 1.35; }
  .capability-callout p { margin: 0 0 .75rem; line-height: 1.7; }
  .capability-callout a { color: var(--sl-color-text-accent); text-underline-offset: .25em; }
  .invitation { max-width: 47rem; margin: 1.5rem 0 0; line-height: 1.7; }
  .invitation a { color: var(--sl-color-text-accent); text-underline-offset: .25em; }
  @media (min-width: 45rem) { .cards { grid-template-columns: repeat(var(--columns), minmax(0, 1fr)); } }
</style>
