---
import FeatureImage from './FeatureImage.astro';
interface Props { images: string[]; layout: string }
const { images, layout } = Astro.props;
const mapLayout = images[0] === 'map-layers';
const splitSizes = '(max-width: 45rem) 90vw, (max-width: 80rem) 45vw, 580px';
---
<div class:list={['gallery', layout, { single: images.length === 1, 'map-layout': mapLayout }]}>
  {images.map((id, index) => <FeatureImage id={id} sizes={images.length > 1 && !(mapLayout && index === 0) ? splitSizes : undefined} />)}
</div>
<style>
  .gallery { display: grid; gap: 1.5rem; align-items: start; }
  @media (min-width: 45rem) {
    .split { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .asymmetric { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); align-items: center; }
    .wide:not(.single) { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: center; }
    .wide.map-layout { grid-template-columns: minmax(0, 1fr); }
    .map-layout > :global(figure:last-child) { width: 70%; justify-self: end; }
  }
</style>
