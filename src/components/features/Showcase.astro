---
import { features } from '../../data/feature-showcase';
import FeatureHero from './FeatureHero.astro';
import FeatureOwnership from './FeatureOwnership.astro';
import FeatureShowcase from './FeatureShowcase.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="showcase not-content">
  <nav aria-label="Explore the showcase">
    <a href="#maps">Worldbuilding</a>
    <a href="#campaign-home">Campaigns</a>
    <a href="#publishing">Storytelling</a>
    <a href="#recruitment">Recruitment</a>
    <a href="#extensibility">Customization</a>
  </nav>
  <FeatureHero />
  <FeatureOwnership />
  {features.map((feature) => <FeatureShowcase feature={feature} />)}
  <section class="closing" aria-labelledby="next-chapter">
    <p class="eyebrow">Free. Self-hosted. Yours.</p>
    <h2 id="next-chapter">Give your next chapter a home.</h2>
    <p>Start with a single campaign, or bring a whole collection of worlds. Host them on your own terms, choose the features and plugins your table needs, and keep your campaign’s memory under your control. Export your campaigns or duplicate them when it is time for a new adventure.</p>
    <div class="actions">
      <a class="primary" href={`${base}/self-hosting/installation/`}>Set up Esiana <span aria-hidden="true">→</span></a>
      <a href={`${base}/features/reference/`}>Browse the guides</a>
      <a href="https://github.com/Esiana-ttrpg/esiana-core">Explore the source ↗</a>
    </div>
  </section>
</div>
<dialog aria-label="Enlarged screenshot" id="feature-image-dialog">
  <div class="dialog-toolbar"><a class="full-image" target="_blank" rel="noopener">Open full-size image ↗</a><button type="button" autofocus>Close <span aria-hidden="true">×</span></button></div>
  <img alt="" />
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#feature-image-dialog');
  if (dialog && typeof dialog.showModal === 'function') {
    const image = dialog.querySelector('img')!;
    const full = dialog.querySelector<HTMLAnchorElement>('.full-image')!;
    let trigger: HTMLAnchorElement | null = null;
    document.querySelectorAll<HTMLAnchorElement>('[data-feature-image]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        trigger = link;
        image.src = link.href;
        image.alt = link.querySelector('img')?.alt ?? '';
        full.href = link.href;
        dialog.showModal();
      });
    });
    dialog.querySelector('button')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => { image.removeAttribute('src'); trigger?.focus(); });
  }
</script>
<style is:global>
  html:has(.showcase) { --sl-content-width: 74rem; }
  html:has(.showcase) .hero { padding-block: clamp(2rem, 3vw, 2.5rem) 1rem; }
  html:has(.showcase) .hero .copy { width: 100%; max-width: 65rem; }
  html:has(.showcase) .hero h1 { max-width: none; font-size: clamp(2.25rem, 3.5vw, 2.625rem); line-height: 1.1; letter-spacing: -.035em; text-wrap: balance; }
  html:has(.showcase) .hero .tagline { max-width: 58rem; text-wrap: pretty; }
  html:has(.showcase) :focus-visible { outline: 3px solid var(--sl-color-text-accent); outline-offset: 4px; }
</style>
<style>
  .showcase { color: var(--sl-color-text); }
  nav { display: flex; flex-wrap: wrap; gap: .55rem; padding-block: 0 1rem; font-size: var(--sl-text-sm); }
  nav a { display: inline-flex; align-items: center; min-height: 2.25rem; padding: .4rem .8rem; border: 1px solid var(--sl-color-hairline); border-radius: 999px; background: color-mix(in srgb, var(--sl-color-bg-nav) 72%, transparent); color: var(--sl-color-text-accent); text-decoration: none; }
  nav a:hover { border-color: var(--sl-color-text-accent); background: color-mix(in srgb, var(--sl-color-text-accent) 10%, transparent); }
  .closing { border-block: 1px solid var(--sl-color-hairline); padding-block: clamp(3rem, 8vw, 6rem); }
  .eyebrow { color: var(--sl-color-text-accent); font-size: var(--sl-text-sm); font-weight: 600; letter-spacing: .07em; text-transform: uppercase; }
  h2 { max-width: 17ch; color: var(--sl-color-white); font-size: clamp(2rem, 5vw, 4rem); line-height: 1.1; letter-spacing: -.04em; }
  .closing p:not(.eyebrow) { max-width: 44rem; margin-block: 1.5rem 2rem; font-size: var(--sl-text-lg); line-height: 1.7; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; }
  .actions a { color: var(--sl-color-text-accent); }
  .actions .primary { display: inline-flex; gap: 1.5rem; padding: .85rem 1.3rem; background: var(--sl-color-text-accent); color: var(--sl-color-text-invert); border-radius: 999px; text-decoration: none; }
  dialog { width: min(96vw, 100rem); max-width: 96vw; max-height: 95vh; padding: 1rem; border: 1px solid var(--sl-color-gray-4); border-radius: .65rem; background: var(--sl-color-bg); color: var(--sl-color-white); }
  dialog::backdrop { background: color-mix(in srgb, var(--sl-color-black) 85%, transparent); }
  .dialog-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .dialog-toolbar a { color: var(--sl-color-text-accent); }
  button { cursor: pointer; border: 1px solid var(--sl-color-gray-4); border-radius: .35rem; padding: .45rem .8rem; background: var(--sl-color-bg); color: var(--sl-color-white); font: inherit; }
  dialog img { display: block; width: 100%; max-height: 78vh; object-fit: contain; }
</style>
