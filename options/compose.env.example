# Pair with compose.docker.example.yml → docker-compose.yml
# Full reference: options/federated-identity.md (canonical OIDC contract)

POSTGRES_PASSWORD=change-me
# Session signing — openssl rand -hex 32 (not the same as AUTH_SECRETS_KEY)
JWT_SECRET=generate-a-random-value

# Optional
# ESIANA_VERSION=latest
# PUBLIC_ORIGIN=http://localhost:8080
#
# Reverse proxy
# TRUST_PROXY=true
# COOKIE_SECURE=true
#
# Authentication
# LOCAL_LOGIN_ENABLED=false disables password authentication.
# LOCAL_LOGIN_ENABLED=true
#
# OpenID Connect (optional — see options/federated-identity.md)
#
# Leave OIDC_ENABLED unset for Admin-managed Identity Providers (default).
#
# Set OIDC_ENABLED=true to manage a single OIDC provider from environment:
# OIDC_PROVIDER_NAME="OpenID Connect"
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
#
# Set OIDC_ENABLED=false to force OIDC off.
#
# AUTH_SECRETS_KEY=              # openssl rand -base64 32 — encrypt stored IdP secrets (not JWT_SECRET)
